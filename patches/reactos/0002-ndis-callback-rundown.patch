+/*
+ * PROJECT:     ReactOS NDIS library
+ * LICENSE:     GPL-2.0-only
+ * PURPOSE:     Miniport callback admission and CPU rundown
+ * COPYRIGHT:   Copyright 2026 RTL8125 ReactOS port contributors
+ */
+#include "ndissys.h"
+
+/* A wrapper callback reference spans the complete miniport call, including its
+ * epilogue. Queued I/O workers separately hold their device/extension through
+ * IopWorkItemCallback. A closed worker never enters miniport code. */
+BOOLEAN
+MiniAcquireLifecycleReference(PLOGICAL_ADAPTER Adapter)
+{
+    KIRQL OldIrql;
+    BOOLEAN Acquired = FALSE;
+    KeAcquireSpinLock(&Adapter->NdisMiniportBlock.Lock, &OldIrql);
+    if (!Adapter->LifecycleClosing)
+    {
+        if (Adapter->LifecycleReferences++ == 0)
+            KeClearEvent(&Adapter->LifecycleDrained);
+        Acquired = TRUE;
+    }
+    KeReleaseSpinLock(&Adapter->NdisMiniportBlock.Lock, OldIrql);
+    return Acquired;
+}
+
+VOID
+MiniReleaseLifecycleReference(PLOGICAL_ADAPTER Adapter)
+{
+    KIRQL OldIrql;
+    KeAcquireSpinLock(&Adapter->NdisMiniportBlock.Lock, &OldIrql);
+    ASSERT(Adapter->LifecycleReferences != 0);
+    if (--Adapter->LifecycleReferences == 0)
+        KeSetEvent(&Adapter->LifecycleDrained, IO_NO_INCREMENT, FALSE);
+    KeReleaseSpinLock(&Adapter->NdisMiniportBlock.Lock, OldIrql);
+}
+
+BOOLEAN
+MiniCloseLifecycle(PLOGICAL_ADAPTER Adapter)
+{
+    KIRQL OldIrql;
+    KAFFINITY Active, Mask;
+    ULONG Processor;
+    BOOLEAN Visited = TRUE;
+    LARGE_INTEGER Timeout;
+    ASSERT(KeGetCurrentIrql() == PASSIVE_LEVEL);
+    KeAcquireSpinLock(&Adapter->NdisMiniportBlock.Lock, &OldIrql);
+    Adapter->LifecycleClosing = TRUE;
+    KeReleaseSpinLock(&Adapter->NdisMiniportBlock.Lock, OldIrql);
+    KeCancelTimer(&Adapter->NdisMiniportBlock.WakeUpDpcTimer.Timer);
+    KeRemoveQueueDpc(&Adapter->NdisMiniportBlock.WakeUpDpcTimer.Dpc);
+    /* Cancel/remove cannot catch a KDPC already dequeued before its first
+     * reference acquisition. A PASSIVE visit to every processor follows the
+     * return of that processor's old DISPATCH-level callback. No new timer
+     * publication is possible after cancellation. KeFlushQueuedDpcs alone
+     * does not cover this case in the matched ReactOS implementation. */
+    Active = KeQueryActiveProcessors();
+    if (!Active)
+        return FALSE;
+    for (Processor = 0; Processor < sizeof(KAFFINITY) * 8; ++Processor)
+    {
+        Mask = (KAFFINITY)1 << Processor;
+        if (!(Active & Mask))
+            continue;
+        KeSetSystemAffinityThread(Mask);
+        if (KeGetCurrentProcessorNumber() != Processor)
+        {
+            Visited = FALSE;
+            break;
+        }
+    }
+    KeRevertToUserAffinityThread();
+    if (!Visited)
+        return FALSE;
+    Timeout.QuadPart = -100000000;
+    return KeWaitForSingleObject(&Adapter->LifecycleDrained, Executive,
+                                 KernelMode, FALSE, &Timeout) == STATUS_SUCCESS;
+}
