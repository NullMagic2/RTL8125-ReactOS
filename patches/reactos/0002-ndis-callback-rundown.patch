+
+/* These wrappers reserve entry before every ordinary request, hang/reset or
+ * worker callback. Release happens only after the miniport routine returns. */
+NDIS_STATUS
+MiniReset(PLOGICAL_ADAPTER Adapter)
+{
+    NDIS_STATUS Status;
+    if (!MiniAcquireLifecycleReference(Adapter))
+        return NDIS_STATUS_CLOSING;
+    Status = MiniResetActive(Adapter);
+    MiniReleaseLifecycleReference(Adapter);
+    return Status;
+}
+
+NDIS_STATUS
+MiniDoRequest(PLOGICAL_ADAPTER Adapter, PNDIS_REQUEST Request)
+{
+    NDIS_STATUS Status;
+    if (!MiniAcquireLifecycleReference(Adapter))
+        return NDIS_STATUS_CLOSING;
+    Status = MiniDoRequestActive(Adapter, Request);
+    MiniReleaseLifecycleReference(Adapter);
+    return Status;
+}
+
+VOID NTAPI
+MiniportHangDpc(PKDPC Dpc, PVOID Context, PVOID Argument1, PVOID Argument2)
+{
+    PLOGICAL_ADAPTER Adapter = Context;
+    if (!MiniAcquireLifecycleReference(Adapter))
+        return;
+    MiniportHangDpcActive(Dpc, Context, Argument1, Argument2);
+    MiniReleaseLifecycleReference(Adapter);
+}
+
+VOID NTAPI
+MiniportWorker(PDEVICE_OBJECT DeviceObject, PVOID Context)
+{
+    PLOGICAL_ADAPTER Adapter = DeviceObject->DeviceExtension;
+    if (!MiniAcquireLifecycleReference(Adapter))
+    {
+        IoFreeWorkItem((PIO_WORKITEM)Context);
+        MiniReleaseLifecycleReference(Adapter); /* Publication reservation. */
+        return;
+    }
+    MiniportWorkerActive(DeviceObject, Context);
+    MiniReleaseLifecycleReference(Adapter); /* Callback entry. */
+    MiniReleaseLifecycleReference(Adapter); /* Publication reservation. */
+}
