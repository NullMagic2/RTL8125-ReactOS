+/*
+ * PROJECT:     ReactOS NDIS library
+ * LICENSE:     GPL-2.0-only
+ * PURPOSE:     Ordered passive NDIS device-power IRP transitions
+ * COPYRIGHT:   Copyright 2026 RTL8125 ReactOS port contributors
+ */
+#include "ndissys.h"
+
+/* Device power IRPs cannot execute PHY or reset polling at dispatch level.
+ * The I/O work item owns FDO lifetime until its routine returns. A separate
+ * reference protects the D0 lower-driver completion before work publication. */
+typedef struct _NDIS_POWER_WORK
+{
+    PDEVICE_OBJECT DeviceObject;
+    PIRP Irp;
+    PIO_WORKITEM WorkItem;
+    NDIS_DEVICE_POWER_STATE State;
+    BOOLEAN LowerCompleted;
+} NDIS_POWER_WORK, *PNDIS_POWER_WORK;
+
+static VOID NTAPI
+NdisPowerWorker(PDEVICE_OBJECT DeviceObject, PVOID Context)
+{
+    PNDIS_POWER_WORK Work = Context;
+    PLOGICAL_ADAPTER Adapter = DeviceObject->DeviceExtension;
+    PIRP Irp = Work->Irp;
+    BOOLEAN LowerCompleted = Work->LowerCompleted;
+    NTSTATUS Status = LowerCompleted ? Irp->IoStatus.Status : STATUS_SUCCESS;
+    NDIS_STATUS NdisStatus;
+    ULONG BytesRead;
+
+    if (NT_SUCCESS(Status))
+    {
+        if (!MiniAcquireLifecycleReference(Adapter))
+            Status = STATUS_DELETE_PENDING;
+        else
+        {
+            /* MiniDoRequest atomically reserves PendingRequest; a competing
+             * protocol OID fails this power attempt without overwriting it. */
+            NdisStatus = MiniSetInformation(Adapter, OID_PNP_SET_POWER,
+                sizeof(Work->State), &Work->State, &BytesRead);
+            if (NdisStatus != NDIS_STATUS_SUCCESS)
+                Status = STATUS_UNSUCCESSFUL;
+            MiniReleaseLifecycleReference(Adapter);
+        }
+    }
+    IoFreeWorkItem(Work->WorkItem);
+    ObDereferenceObject(Work->DeviceObject);
+    ExFreePool(Work);
+
+    if (LowerCompleted)
+    {
+        Irp->IoStatus.Status = Status;
+        IoCompleteRequest(Irp, IO_NO_INCREMENT);
+    }
+    else
+    {
+        PoStartNextPowerIrp(Irp);
+        if (NT_SUCCESS(Status))
+        {
+            /* Dx: NIC quiescence and DMA retirement preceded lower PCI power. */
+            IoSkipCurrentIrpStackLocation(Irp);
+            PoCallDriver(Adapter->NdisMiniportBlock.NextDeviceObject, Irp);
+        }
+        else
+        {
+            Irp->IoStatus.Status = Status;
+            IoCompleteRequest(Irp, IO_NO_INCREMENT);
+        }
+    }
+}
+
+static NTSTATUS NTAPI
+NdisPowerLowerComplete(PDEVICE_OBJECT DeviceObject, PIRP Irp, PVOID Context)
+{
+    PNDIS_POWER_WORK Work = Context;
+    UNREFERENCED_PARAMETER(DeviceObject);
+    UNREFERENCED_PARAMETER(Irp);
+    IoQueueWorkItem(Work->WorkItem, NdisPowerWorker, DelayedWorkQueue, Work);
+    return STATUS_MORE_PROCESSING_REQUIRED;
+}
+
+NTSTATUS
+NTAPI
+NdisIPower(PDEVICE_OBJECT DeviceObject, PIRP Irp)
+{
+    PLOGICAL_ADAPTER Adapter = DeviceObject->DeviceExtension;
+    PIO_STACK_LOCATION Stack = IoGetCurrentIrpStackLocation(Irp);
+    PNDIS_POWER_WORK Work;
+    if (Stack->MinorFunction != IRP_MN_SET_POWER ||
+        Stack->Parameters.Power.Type != DevicePowerState ||
+        Adapter->NdisMiniportBlock.PnPDeviceState != NdisPnPDeviceStarted)
+    {
+        PoStartNextPowerIrp(Irp);
+        IoSkipCurrentIrpStackLocation(Irp);
+        return PoCallDriver(Adapter->NdisMiniportBlock.NextDeviceObject, Irp);
+    }
+    Work = ExAllocatePool(NonPagedPool, sizeof(*Work));
+    if (Work == NULL)
+        goto AllocationFailure;
+    RtlZeroMemory(Work, sizeof(*Work));
+    Work->WorkItem = IoAllocateWorkItem(DeviceObject);
+    if (Work->WorkItem == NULL)
+    {
+        ExFreePool(Work);
+        goto AllocationFailure;
+    }
+    Work->DeviceObject = DeviceObject;
+    Work->Irp = Irp;
+    Work->State = (NDIS_DEVICE_POWER_STATE)Stack->Parameters.Power.State.DeviceState;
+    Work->LowerCompleted = Work->State == NdisDeviceStateD0;
+    ObReferenceObject(DeviceObject);
+    IoMarkIrpPending(Irp);
+    if (Work->LowerCompleted)
+    {
+        /* D0: PCI power and BAR decoding are restored before the NIC restart. */
+        IoCopyCurrentIrpStackLocationToNext(Irp);
+        IoSetCompletionRoutine(Irp, NdisPowerLowerComplete, Work, TRUE, TRUE, TRUE);
+        PoStartNextPowerIrp(Irp);
+        PoCallDriver(Adapter->NdisMiniportBlock.NextDeviceObject, Irp);
+    }
+    else
+        IoQueueWorkItem(Work->WorkItem, NdisPowerWorker, DelayedWorkQueue, Work);
+    return STATUS_PENDING;
+
+AllocationFailure:
+    PoStartNextPowerIrp(Irp);
+    Irp->IoStatus.Status = STATUS_INSUFFICIENT_RESOURCES;
+    IoCompleteRequest(Irp, IO_NO_INCREMENT);
+    return STATUS_INSUFFICIENT_RESOURCES;
+}
